---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ColonyField from '../components/ColonyField';
import nivoraIcon from '../assets/apps/nivora.png';
import voxmarkIcon from '../assets/apps/voxmark.png';
import basalttyIcon from '../assets/apps/basaltty.png';

const apps = [
	{
		name: 'Nivora',
		icon: nivoraIcon,
		blurb:
			'Snow companion for skiers and snowboarders. Avalanche bulletins, weather, lift status and resort webcams in one place, plus the safety tools you actually need in the backpack.',
		platforms: 'iOS',
		cta: 'App Store',
		url: 'https://apps.apple.com/us/app/nivora/id6468679836',
	},
	{
		name: 'VoxMark',
		icon: voxmarkIcon,
		blurb:
			'A digital lyric book for vocalists and coaches. Mark up breathing, dynamics and technique cues on a song, then follow them at your own pace.',
		platforms: 'iOS · watchOS',
		cta: 'App Store',
		url: 'https://apps.apple.com/us/app/voxmark-voice-lyrics-cues/id6760473103',
	},
	{
		name: 'Basaltty',
		icon: basalttyIcon,
		blurb:
			"A terminal that follows you off the desk. The coding agent keeps running on your Mac while you answer it from the sofa, and the tabs name themselves using a model that never leaves the machine.",
		platforms: 'macOS · iOS',
		cta: 'Read more',
		url: 'https://fezvrasta.github.io/basaltty/',
	},
];

const workTabs = [
	{
		id: 'popular',
		label: 'Popular projects',
		items: [
			{
				n: '01',
				name: 'Floating UI',
				blurb: 'Positioning engine for tooltips, popovers and every other floating element. Co-creator.',
				meta: '32.7k ★',
				url: 'https://github.com/floating-ui/floating-ui',
			},
			{
				n: '02',
				name: 'Popper.js',
				blurb: 'The original. Shipped in Bootstrap, Material UI and most of the ecosystem for a decade.',
				meta: '2016 – 2021',
				url: 'https://popper.js.org',
			},
			{
				n: '03',
				name: 'React Resize Aware',
				blurb: "A React hook for listening to an element's resize events. No ResizeObserver boilerplate.",
				meta: '565 ★',
				url: 'https://github.com/FezVrasta/react-resize-aware',
			},
			{
				n: '04',
				name: 'Bootstrap Material Design',
				blurb: 'Material Design as a Bootstrap theme, back when that was a thing people needed.',
				meta: '2014',
				url: 'https://github.com/FezVrasta/bootstrap-material-design',
			},
		],
	},
	{
		id: 'home-assistant',
		label: 'Home Assistant',
		items: [
			{
				n: '01',
				name: 'C.A.F.E.',
				blurb: 'A third way to write Home Assistant automations: a visual, state-machine based editor.',
				meta: '1.7k ★',
				url: 'https://github.com/FezVrasta/cafe-hass',
			},
			{
				n: '02',
				name: 'HA RBAC',
				blurb: 'Role-based access control for Home Assistant. Guests see the lights, kids get their own dashboard.',
				meta: '53 ★',
				url: 'https://github.com/FezVrasta/ha-rbac',
			},
			{
				n: '03',
				name: 'Pull-Down Card',
				blurb: 'iOS-style pull-down drawer card for Home Assistant dashboards.',
				meta: '25 ★',
				url: 'https://github.com/FezVrasta/pull-down-card',
			},
			{
				n: '04',
				name: 'Glass Thermostat Card',
				blurb: 'A liquid glass style thermostat card for Home Assistant.',
				meta: '23 ★',
				url: 'https://github.com/FezVrasta/glass-thermostat-card',
			},
		],
	},
	{
		id: 'career',
		label: 'Career',
		items: [
			{
				n: '01',
				name: 'Cantina',
				blurb: 'Senior software engineer, building the frontend for a Web3 security-review platform and Clarion, its AI-powered security product.',
				meta: '2025 – present',
				url: 'https://cantina.xyz',
			},
			{
				n: '02',
				name: 'OddsJam',
				blurb: 'Staff software engineer. Designed and built BetBucket from scratch: backend, frontend and database.',
				meta: '2024',
				url: 'https://oddsjam.com',
			},
			{
				n: '03',
				name: 'Sirona Medical',
				blurb: 'Staff software engineer and tech lead. Took the frontend from MVP to an enterprise product used in clinical production.',
				meta: '2020 – 2024',
				url: 'https://sironamedical.com',
			},
			{
				n: '04',
				name: 'Quid',
				blurb: 'Frontend developer on an AI-driven market intelligence platform, building the data-heavy visualization UI.',
				meta: '2016 – 2020',
				url: 'https://quid.com',
			},
			{
				n: '05',
				name: 'Sysdig',
				blurb: 'Front-end developer. Revamped the UI of a cloud security-monitoring product.',
				meta: '2015 – 2016',
				url: 'https://sysdig.com',
			},
		],
	},
];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title='Federico "Fez Vrasta" Zivolo'>
	<div class="page">
		<ColonyField client:load pattern="colonies" colorway="lime" attract={true} />
		<div class="scrim" aria-hidden="true"></div>

		<div class="content">
			<header class="site-header">
				<a href="/" class="logo">fezvrasta</a>
				<nav class="site-nav">
					<a href="#apps" class="hover-link">apps</a>
					<a href="#work" class="hover-link">work</a>
					<a href="#writing" class="hover-link">writing</a>
					<a href="https://github.com/fezvrasta" class="hover-link">github</a>
				</nav>
			</header>

			<section class="hero">
				<p class="hero-eyebrow">Senior software engineer &middot; Milano, Italy</p>
				<h1 class="hero-title">I ship products. Sometimes I build the pieces they're built from.</h1>
				<p class="hero-desc">
					Fifteen years shipping frontends for security monitoring, machine learning, medical imaging and betting.
					Also wrote Popper.js, co-created Floating&nbsp;UI, and tinker with Home&nbsp;Assistant.
				</p>
				<p class="hero-hint">The colonies feed, grow, and outgrow the frame. Leave a trail for them.</p>
			</section>

			<section id="apps" class="section section-apps">
				<h2 class="section-title">Apps</h2>
				<p class="section-lede">
					Things I build on the side, mostly because I wanted them to exist and nobody else had made them.
				</p>
				<div class="app-grid">
					{apps.map((app) => (
						<a href={app.url} class="app-card">
							<Image src={app.icon} alt={`${app.name} app icon`} width={176} height={176} class="app-icon" loading="lazy" />
							<span class="app-body">
								<span class="app-name">{app.name}</span>
								<span class="app-platforms">{app.platforms}</span>
								<span class="app-blurb">{app.blurb}</span>
							</span>
							<span class="app-cta">{app.cta}</span>
						</a>
					))}
				</div>
			</section>

			<section id="work" class="section">
				<h2 class="section-title">Selected work</h2>
				<div class="tabs">
					{workTabs.map((tab, i) => (
						<input
							type="radio"
							name="work-tab"
							id={`tab-${tab.id}`}
							class="tab-radio"
							checked={i === 0}
						/>
					))}
					<div class="tab-bar">
						{workTabs.map((tab) => (
							<label for={`tab-${tab.id}`} class="tab-label">
								{tab.label}
							</label>
						))}
					</div>
					<div class="tab-panels">
						{workTabs.map((tab) => (
							<div class={`tab-panel panel-${tab.id} list`}>
								{tab.items.map((p) => (
									<a href={p.url} class="row project-row">
										<span class="project-index">{p.n}</span>
										<span class="row-body">
											<span class="project-name">{p.name}</span>
											<span class="row-blurb">{p.blurb}</span>
										</span>
										<span class="row-meta">{p.meta}</span>
									</a>
								))}
							</div>
						))}
					</div>
				</div>
			</section>

			<section id="writing" class="section section-writing">
				<h2 class="section-title">Writing</h2>
				<p class="section-lede">
					Notes on the projects above: what broke, what I would do differently, and the occasional argument about the
					platform.
				</p>
				{
					posts.length > 0 ? (
						<>
							<div class="list">
								{posts.map((post) => (
									<a href={`/blog/${post.id}`} class="row post-row">
										<span class="post-date">
											{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' })}
										</span>
										<span class="row-body">
											<span class="post-title">{post.data.title}</span>
											<span class="row-blurb post-dek">{post.data.dek}</span>
										</span>
									</a>
								))}
							</div>
							<p class="section-note">
								These posts are written with AI assistance. I don't have time to write them all myself, but I'd rather
								share the thoughts than not.
							</p>
						</>
					) : (
						<p class="section-note">No posts yet, check back soon.</p>
					)
				}
			</section>

			<footer class="site-footer">
				<a href="https://github.com/fezvrasta" class="hover-link">github</a>
				<a href="https://www.linkedin.com/in/fezvrasta/" class="hover-link">linkedin</a>
				<a href="https://github.com/sponsors/FezVrasta" class="hover-link">sponsor</a>
			</footer>
		</div>
	</div>
</BaseLayout>

<style>
	.page {
		position: relative;
		min-height: 100vh;
		background: #0d0e12;
		overflow: hidden;
	}

	.scrim {
		position: fixed;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(
				100deg,
				rgba(13, 14, 18, 0.94) 0%,
				rgba(13, 14, 18, 0.9) 34%,
				rgba(13, 14, 18, 0.55) 62%,
				rgba(13, 14, 18, 0.12) 86%,
				rgba(13, 14, 18, 0) 100%
			),
			linear-gradient(180deg, rgba(13, 14, 18, 0.82) 0%, rgba(13, 14, 18, 0.5) 6%, rgba(13, 14, 18, 0) 15%);
	}

	.content {
		position: relative;
		z-index: 2;
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 40px 140px;
	}

	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 32px;
		padding: 34px 0 0;
	}

	.logo {
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
		letter-spacing: 0.06em;
		color: #f2f3f5;
	}

	.site-nav {
		display: flex;
		gap: 28px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
		letter-spacing: 0.02em;
	}

	.hover-link {
		color: #9a9ea8;
		transition: color 200ms ease;
	}
	.hover-link:hover {
		color: #ffffff;
	}

	.hero {
		min-height: 74vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 30px;
		padding: 90px 0 60px;
		max-width: 660px;
	}

	.hero-eyebrow {
		margin: 0;
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #7f8490;
	}

	.hero-title {
		margin: 0;
		font-size: 58px;
		line-height: 1.04;
		letter-spacing: -0.025em;
		font-weight: 500;
		text-wrap: pretty;
	}

	.hero-desc {
		margin: 0;
		font-size: 19px;
		line-height: 1.6;
		color: #b7bcc6;
		max-width: 560px;
		text-wrap: pretty;
	}

	.hero-hint {
		margin: 8px 0 0;
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		color: #8b909b;
	}

	.section {
		padding: 70px 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.section-apps {
		padding-bottom: 70px;
	}

	.app-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}

	.app-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
		padding: 26px 24px 24px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;
		background: rgba(13, 14, 18, 0.34);
		backdrop-filter: blur(2px);
		transition:
			background 260ms ease,
			border-color 260ms ease,
			transform 260ms ease;
	}
	.app-card:hover {
		background: rgba(24, 27, 33, 0.72);
		border-color: rgba(255, 255, 255, 0.16);
		transform: translateY(-3px);
	}

	.app-icon {
		width: 88px;
		height: 88px;
		border-radius: 21px;
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.08),
			0 12px 28px rgba(0, 0, 0, 0.45);
		transition: transform 260ms ease;
	}
	.app-card:hover .app-icon {
		transform: scale(1.04);
	}

	.app-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1;
	}

	.app-name {
		font-size: 25px;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.app-platforms {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		letter-spacing: 0.02em;
		color: #6f747f;
	}

	.app-blurb {
		margin-top: 2px;
		font-size: 15px;
		line-height: 1.55;
		color: #9a9ea8;
		text-wrap: pretty;
	}

	.app-cta {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		letter-spacing: 0.02em;
		color: #9a9ea8;
		transition: color 200ms ease;
	}
	.app-cta::after {
		content: '\2192';
		display: inline-block;
		margin-left: 7px;
		transition: transform 260ms ease;
	}
	.app-card:hover .app-cta {
		color: #ffffff;
	}
	.app-card:hover .app-cta::after {
		transform: translateX(4px);
	}

	.section-writing {
		padding-top: 90px;
		border-top: none;
	}

	.section-title {
		margin: 0 0 40px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #7f8490;
		font-weight: 400;
	}

	.section-lede {
		margin: -14px 0 30px;
		font-size: 17px;
		line-height: 1.55;
		color: #9a9ea8;
		max-width: 520px;
	}

	.section-note {
		margin: 22px 0 0;
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		color: #6f747f;
	}

	.list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px 16px;
	}

	.tab-radio {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.tab-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 28px;
		margin: 0 0 32px;
	}

	.tab-label {
		padding: 4px 0 10px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
		letter-spacing: 0.02em;
		color: #7f8490;
		border-bottom: 2px solid transparent;
		cursor: pointer;
		transition:
			color 200ms ease,
			border-color 200ms ease;
	}
	.tab-label:hover {
		color: #d7d9de;
	}

	.tab-panel {
		display: none;
	}

	#tab-popular:checked ~ .tab-bar label[for='tab-popular'],
	#tab-home-assistant:checked ~ .tab-bar label[for='tab-home-assistant'],
	#tab-career:checked ~ .tab-bar label[for='tab-career'] {
		color: #f2f3f5;
		border-bottom-color: rgba(255, 255, 255, 0.4);
	}

	#tab-popular:checked ~ .tab-panels .panel-popular,
	#tab-home-assistant:checked ~ .tab-panels .panel-home-assistant,
	#tab-career:checked ~ .tab-panels .panel-career {
		display: grid;
	}

	#tab-popular:focus-visible ~ .tab-bar label[for='tab-popular'],
	#tab-home-assistant:focus-visible ~ .tab-bar label[for='tab-home-assistant'],
	#tab-career:focus-visible ~ .tab-bar label[for='tab-career'] {
		outline: 2px solid rgba(255, 255, 255, 0.5);
		outline-offset: 2px;
	}

	.row {
		display: grid;
		gap: 28px;
		align-items: start;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;
		background: rgba(13, 14, 18, 0.34);
		backdrop-filter: blur(2px);
	}

	.project-row {
		grid-template-columns: 46px minmax(0, 1fr) auto;
		padding: 24px 22px 24px 18px;
		transition:
			background 260ms ease,
			padding-left 260ms ease;
	}
	.project-row:hover {
		background: rgba(24, 27, 33, 0.72);
		padding-left: 28px;
	}

	.post-row {
		grid-template-columns: 110px minmax(0, 1fr) auto;
		padding: 26px 22px 26px 18px;
		transition:
			background 260ms ease,
			padding-left 260ms ease;
	}
	.post-row:hover {
		background: rgba(24, 27, 33, 0.72);
		padding-left: 28px;
	}

	.project-index {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		color: #5e636e;
		padding-top: 7px;
	}

	.post-date {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		color: #5e636e;
		padding-top: 6px;
	}

	.row-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.project-name {
		font-size: 25px;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.post-title {
		font-size: 23px;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.row-blurb {
		font-size: 15px;
		line-height: 1.55;
		color: #9a9ea8;
		max-width: 46ch;
	}

	.post-dek {
		line-height: 1.6;
		max-width: 48ch;
	}

	.row-meta {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		color: #6f747f;
		white-space: nowrap;
		padding-top: 9px;
	}

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 28px;
		padding: 60px 0 0;
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
	}

	@media (max-width: 900px) {
		.list {
			grid-template-columns: 1fr;
		}
		.app-grid {
			grid-template-columns: 1fr;
		}
		.app-card {
			flex-direction: row;
			align-items: flex-start;
			gap: 22px;
		}
		.app-icon {
			width: 64px;
			height: 64px;
			border-radius: 15px;
			flex: none;
		}
		.app-cta {
			align-self: center;
			white-space: nowrap;
		}
	}

	@media (max-width: 720px) {
		.content {
			padding: 0 20px 100px;
		}
		.hero-title {
			font-size: 38px;
		}
		.project-row,
		.post-row {
			grid-template-columns: 1fr;
			gap: 10px;
		}
		.project-index,
		.post-date,
		.row-meta {
			padding-top: 0;
		}
		.app-card {
			flex-direction: column;
			gap: 16px;
			padding: 22px 20px;
		}
		.app-cta {
			align-self: flex-start;
		}
	}
</style>
