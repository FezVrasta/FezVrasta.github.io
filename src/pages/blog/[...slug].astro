---
import { existsSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Written by scripts/ensure-discussions.mjs during the deploy workflow, one GitHub
// Discussion per post, used as that post's comment thread. Not present locally unless
// that script has been run by hand, so the button below only shows up when it exists.
const discussionLinksPath = fileURLToPath(new URL('../../data/discussion-links.json', import.meta.url));
const discussionLinks = existsSync(discussionLinksPath)
	? JSON.parse(readFileSync(discussionLinksPath, 'utf8'))
	: {};
const discussionUrl = discussionLinks[post.id];
---

<BaseLayout title={`${post.data.title} · fezvrasta`} description={post.data.dek}>
	<div class="page">
		<div class="header-bar">
			<header class="site-header">
				<a href="/" class="logo">fezvrasta</a>
				<nav class="site-nav">
					<a href="/#work" class="hover-link">work</a>
					<a href="/blog" class="hover-link">writing</a>
					<a href="https://github.com/fezvrasta" class="hover-link">github</a>
				</nav>
			</header>
		</div>

		<div class="content">
			<article class="post">
				<p class="post-date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' })}</p>
				<h1 class="post-title">{post.data.title}</h1>
				<p class="post-dek">{post.data.dek}</p>
				<p class="ai-disclaimer">
					Written with AI assistance. I don't have time to write every post myself, but I'd rather share the thoughts
					than not.
				</p>
				<div class="prose">
					<Content />
				</div>

				<div class="post-actions">
					{
						discussionUrl && (
							<a href={discussionUrl} class="action-button" target="_blank" rel="noopener noreferrer">
								Comment on GitHub
							</a>
						)
					}
					<button
						type="button"
						id="share-button"
						class="action-button"
						data-title={post.data.title}
						data-text={post.data.dek}
						hidden
					>
						Share
					</button>
				</div>

				<div class="author-card">
					<img src="/avatar.jpeg" alt="" class="author-avatar" width="84" height="84" />
					<div class="author-body">
						<span class="author-label">About</span>
						<span class="author-name">Federico Zivolo</span>
						<p class="author-bio">
							Frontend engineer in Milano. Fifteen years shipping frontends: security monitoring, machine learning,
							medical imaging, betting, Web3, and now AI security. Wrote Popper.js and co-created Floating UI.
						</p>
					</div>
				</div>
			</article>

			<footer class="site-footer">
				<a href="https://github.com/fezvrasta" class="hover-link">github</a>
				<a href="https://www.linkedin.com/in/fezvrasta/" class="hover-link">linkedin</a>
				<a href="https://github.com/sponsors/FezVrasta" class="hover-link">sponsor</a>
			</footer>
		</div>
	</div>
</BaseLayout>

<script>
	const button = document.getElementById('share-button') as HTMLButtonElement | null;
	if (button && navigator.share) {
		button.hidden = false;
		button.addEventListener('click', async () => {
			try {
				await navigator.share({
					title: button.dataset.title,
					text: button.dataset.text,
					url: location.href,
				});
			} catch (err) {
				if ((err as Error)?.name !== 'AbortError') throw err;
			}
		});
	}
</script>

<style>
	.page {
		position: relative;
		min-height: 100vh;
		background: #0d0e12;
	}
	.header-bar {
		position: relative;
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 40px;
	}
	.content {
		position: relative;
		max-width: 760px;
		margin: 0 auto;
		padding: 0 40px 140px;
	}
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 32px;
		padding: 34px 0 0;
	}
	.logo {
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
		letter-spacing: 0.06em;
		color: #f2f3f5;
	}
	.site-nav {
		display: flex;
		gap: 28px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
		letter-spacing: 0.02em;
	}
	.hover-link {
		color: #9a9ea8;
		transition: color 200ms ease;
	}
	.hover-link:hover {
		color: #ffffff;
	}
	.post {
		padding: 90px 0 0;
	}
	.post-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin: 50px 0 0;
	}
	.action-button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 18px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 10px;
		background: none;
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
		color: #d7d9de;
		cursor: pointer;
		transition:
			background 200ms ease,
			border-color 200ms ease;
	}
	.action-button:hover {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.28);
		color: #ffffff;
	}
	.author-card {
		display: grid;
		grid-template-columns: 84px minmax(0, 1fr);
		gap: 22px;
		align-items: start;
		margin: 40px 0 0;
		padding: 26px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 18px;
		background: rgba(19, 21, 26, 0.6);
	}
	.author-avatar {
		width: 100%;
		aspect-ratio: 1;
		box-sizing: border-box;
		border-radius: 14px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		object-fit: cover;
	}
	.author-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.author-label {
		font-family: 'JetBrains Mono', monospace;
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #6f747f;
	}
	.author-name {
		font-size: 20px;
		letter-spacing: -0.015em;
	}
	.author-bio {
		margin: 0;
		font-size: 15.5px;
		line-height: 1.6;
		color: #9a9ea8;
		max-width: 46ch;
	}
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 28px;
		padding: 60px 0 0;
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
	}
	.post-date {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		letter-spacing: 0.06em;
		color: #7f8490;
		margin: 0 0 18px;
	}
	.post-title {
		margin: 0 0 18px;
		font-size: 42px;
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-weight: 500;
	}
	.post-dek {
		margin: 0 0 24px;
		font-size: 19px;
		line-height: 1.6;
		color: #b7bcc6;
	}
	.ai-disclaimer {
		margin: 0 0 50px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		line-height: 1.6;
		color: #6f747f;
	}
	.prose {
		font-size: 17px;
		line-height: 1.7;
		color: #d7d9de;
	}
	.prose :global(h2) {
		font-size: 26px;
		letter-spacing: -0.01em;
		margin: 48px 0 18px;
	}
	.prose :global(h3) {
		font-size: 21px;
		margin: 36px 0 14px;
	}
	.prose :global(p) {
		margin: 0 0 20px;
	}
	.prose :global(a) {
		color: #f2f3f5;
		text-decoration: underline;
		text-decoration-color: rgba(255, 255, 255, 0.3);
	}
	.prose :global(code) {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.9em;
		background: rgba(255, 255, 255, 0.08);
		padding: 0.15em 0.4em;
		border-radius: 4px;
	}
	.prose :global(pre) {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 20px;
		overflow-x: auto;
	}
	.prose :global(pre code) {
		background: none;
		padding: 0;
	}
	.prose :global(blockquote) {
		margin: 0 0 20px;
		padding-left: 18px;
		border-left: 2px solid rgba(255, 255, 255, 0.16);
		color: #9a9ea8;
	}
	@media (max-width: 720px) {
		.header-bar {
			padding: 0 20px;
		}
		.content {
			padding: 0 20px 100px;
		}
		.post-title {
			font-size: 30px;
		}
		.author-card {
			grid-template-columns: 56px minmax(0, 1fr);
			padding: 20px;
		}
	}
</style>
